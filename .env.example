# Local development. Requires Node.js 24.22.2 or newer in the 24.x LTS line.
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_PATH=data/closeword.sqlite
MAIL_TRANSPORT=resend
# Put a real sending-only Resend key in this private file.
RESEND_API_KEY_FILE=.secrets/resend_api_key
# Set a sender on your verified domain to enable account verification.
EMAIL_FROM=
METRICS_TOKEN_FILE=.secrets/metrics.token
BACKUP_KEY_FILE=.secrets/backup.key
BACKUP_DIR=backups
COOKIE_SECURE=false
TRUST_PROXY=false
# For compose.yaml, also set a public hostname:
# DOMAIN=game.yourdomain.com
