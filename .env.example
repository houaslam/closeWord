# Optional: local play works without this file or email credentials.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/mvp.sqlite
TRUST_PROXY=false
# Public deployment (Compose):
# DOMAIN=game.yourdomain.com
# Non-Compose production:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://game.yourdomain.com
# Optional monitoring and encrypted backups; generate with npm run secrets:init:
# METRICS_TOKEN_FILE=.secrets/metrics.token
# BACKUP_KEY_FILE=.secrets/backup.key
# BACKUP_DIR=backups

# Vercel / shared Redis deployment: see .env.vercel.example and VERCEL.md.
# GAME_STORAGE=redis
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-private-read-write-token
