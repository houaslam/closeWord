# Add these in Vercel > Project > Settings > Environment Variables.
# They are SERVER secrets: never add a NEXT_PUBLIC_ prefix.
# Upstash Redis through Vercel Marketplace can inject them automatically.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token

# Optional: on Vercel this defaults to redis and cannot use sqlite.
GAME_STORAGE=redis

# Optional: set this only if you use a custom domain; omit for *.vercel.app.
# PUBLIC_ORIGIN=https://game.yourdomain.com

# Optional: the defaults isolate Production and each Preview deployment.
# Only override with DIFFERENT values for Preview and Production.
# GAME_NAMESPACE=production

# Optional: generate a private random token to enable protected /metrics.
# METRICS_TOKEN=replace-with-a-random-operator-token

# Do not configure DATABASE_PATH, HOST, PORT, TRUST_PROXY, or *_FILE on Vercel.
# No email provider or authentication settings are needed for this MVP.
