# Vercel > Project > Settings > Environment Variables > Production (and Preview).
# Run supabase/migrations/202611090001_closeword.sql in Supabase's SQL editor first.
GAME_STORAGE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_secret_key

# Legacy service_role keys are also supported instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_jwt
# Never put a server key in a NEXT_PUBLIC_ variable or use an anon/publishable key.

# Optional custom domain; omit for the generated *.vercel.app address.
# PUBLIC_ORIGIN=https://game.yourdomain.com

# Optional: defaults isolate Production and each Preview deployment.
# If overridden, use different values for Preview and Production.
# GAME_NAMESPACE=production

# Optional protected operator metrics:
# METRICS_TOKEN=replace-with-a-random-operator-token

# Redis remains available only when explicitly selected:
# GAME_STORAGE=redis
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-private-read-write-token

# No DATABASE_PATH, HOST, PORT, TRUST_PROXY, *_FILE, or email settings on Vercel.
